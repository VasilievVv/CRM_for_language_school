#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.Ученики") Тогда
		Ученик = ДанныеЗаполнения;
		ЗаполнитьПлательщикаПоУченику();
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если Не ЗначениеЗаполнено(Плательщик) Тогда
		ЗаполнитьПлательщикаПоУченику();
	КонецЕсли;

	РассчитатьИтоговуюСтоимость();

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	ПроверитьОбязательныеРеквизиты(Отказ);
	ПроверитьСоответствиеПлательщика(Отказ);
	ПроверитьПериодДоговора(Отказ);
	ПроверитьПриостановления(Отказ);
	ПроверитьГрафикОказанияУслуг(Отказ);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	ПроверитьОбязательныеРеквизиты(Отказ);
	ПроверитьГрафикОказанияУслуг(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Движения.ЦеныСкидкиКлиентов.Записывать = Истина;
	Движение = Движения.ЦеныСкидкиКлиентов.Добавить();
	Движение.Плательщик        = Плательщик;
	Движение.Ученик            = Ученик;
	Движение.Направление       = Направление;
	Движение.Договор           = Ссылка;
	Движение.ЦенаСУчетомСкидки = ИтоговаяСтоимостьЗанятия;
	Движение.РазмерСкидки      = СкидкаФиксированная;

	СтатусДоговора = Перечисления.СтатусыДоговора.Действующий;
	Записать(РежимЗаписиДокумента.Запись);

	Документы.ДоговорОбучения.СинхронизироватьСвязанныеОбъекты(Ссылка);

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	СтатусДоговора = Перечисления.СтатусыДоговора.Проект;
	Записать(РежимЗаписиДокумента.Запись);

	Документы.ДоговорОбучения.СинхронизироватьСвязанныеОбъекты(Ссылка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВладелецУченика()

	Если Не ЗначениеЗаполнено(Ученик) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ученик, "Владелец").Владелец;

КонецФункции

Процедура ЗаполнитьПлательщикаПоУченику()

	Владелец = ВладелецУченика();
	Если Не ЗначениеЗаполнено(Владелец) Тогда
		Возврат;
	КонецЕсли;

	Плательщик = Владелец;

КонецПроцедуры

Процедура РассчитатьИтоговуюСтоимость()

	Если Не (ЗначениеЗаполнено(Программа)
			И ЗначениеЗаполнено(ФормаЗанятий)
			И ЗначениеЗаполнено(УчебныйГод)) Тогда
		Возврат;
	КонецЕсли;

	Цена = Документы.ДоговорОбучения.ЦенаЗаЗанятие(Программа, ФормаЗанятий, УчебныйГод, ДатаНачала);
	Если Цена = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИтоговаяСтоимостьЗанятия = Макс(Цена - СкидкаФиксированная, 0);

КонецПроцедуры

Процедура ПроверитьСоответствиеПлательщика(Отказ)

	Если Не (ЗначениеЗаполнено(Плательщик) И ЗначениеЗаполнено(Ученик)) Тогда
		Возврат;
	КонецЕсли;

	Если Плательщик = ВладелецУченика() Тогда
		Возврат;
	КонецЕсли;

	ВывестиСообщение(
		"Плательщик должен совпадать с владельцем ученика.",
		"Плательщик");
	Отказ = Истина;

КонецПроцедуры

Процедура ПроверитьПериодДоговора(Отказ)

	Если Не (ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания)) Тогда
		Возврат;
	КонецЕсли;

	Если ДатаОкончания >= ДатаНачала Тогда
		Возврат;
	КонецЕсли;

	ВывестиСообщение(
		"Дата окончания договора не может быть раньше даты начала.",
		"ДатаОкончания");
	Отказ = Истина;

КонецПроцедуры

Процедура ПроверитьПриостановления(Отказ)

	Для Каждого СтрокаПриостановки Из ПриостановленияЗанятий Цикл

		Если Не (ЗначениеЗаполнено(СтрокаПриостановки.ДатаНачала)
				И ЗначениеЗаполнено(СтрокаПриостановки.ДатаОкончания)) Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаПриостановки.ДатаОкончания < СтрокаПриостановки.ДатаНачала Тогда
			ВывестиСообщение(
				"Строка " + СтрокаПриостановки.НомерСтроки
					+ ": дата окончания приостановки не может быть раньше даты начала.",
				"ПриостановленияЗанятий");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		Если Не (ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания)) Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаПриостановки.ДатаНачала < ДатаНачала
				Или СтрокаПриостановки.ДатаОкончания > ДатаОкончания Тогда
			ВывестиСообщение(
				"Строка " + СтрокаПриостановки.НомерСтроки
					+ ": приостановка выходит за период действия договора.",
				"ПриостановленияЗанятий");
			Отказ = Истина;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОбязательныеРеквизиты(Отказ)

	Если Не ЗначениеЗаполнено(Плательщик) Тогда
		ВывестиСообщение("Не заполнен плательщик.", "Плательщик");
		Отказ = Истина;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Ученик) Тогда
		ВывестиСообщение("Не заполнен ученик.", "Ученик");
		Отказ = Истина;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Направление) Тогда
		ВывестиСообщение("Не заполнено направление.", "Направление");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьГрафикОказанияУслуг(Отказ)

	Если ГрафикОказанияУслуг.Количество() = 0 Тогда
		ВывестиСообщение("Не заполнен график оказания услуг.", "ГрафикОказанияУслуг");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ВстреченныеДни = Новый Соответствие;

	Для Каждого СтрокаГрафика Из ГрафикОказанияУслуг Цикл

		Если Не ЗначениеЗаполнено(СтрокаГрафика.Группа) Тогда
			ВывестиСообщение(
				"Строка " + СтрокаГрафика.НомерСтроки + ": не заполнена группа.",
				"ГрафикОказанияУслуг");
			Отказ = Истина;
		КонецЕсли;

		Если СтрокаГрафика.ДеньНедели = Перечисления.ДниНедели.Суббота
				Или СтрокаГрафика.ДеньНедели = Перечисления.ДниНедели.Воскресенье Тогда
			ВывестиСообщение(
				"Строка " + СтрокаГрафика.НомерСтроки + ": занятия в выходной день недопустимы.",
				"ГрафикОказанияУслуг");
			Отказ = Истина;
		КонецЕсли;

		Если ВстреченныеДни.Получить(СтрокаГрафика.ДеньНедели) <> Неопределено Тогда
			ВывестиСообщение(
				"Строка " + СтрокаГрафика.НомерСтроки + ": день недели указан повторно.",
				"ГрафикОказанияУслуг");
			Отказ = Истина;
		КонецЕсли;
		ВстреченныеДни.Вставить(СтрокаГрафика.ДеньНедели, Истина);

	КонецЦикла;

КонецПроцедуры

Процедура ВывестиСообщение(Текст, Поле)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#КонецЕсли
