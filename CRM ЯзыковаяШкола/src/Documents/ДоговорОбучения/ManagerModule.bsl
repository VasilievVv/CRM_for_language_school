#Область ПрограммныйИнтерфейс

// Возвращает стоимость одного занятия по данным регистра сведений "ЦеныОбучения".
//
// Параметры:
//   ВозрастнаяГруппа - СправочникСсылка.ОбучающиеПрограммы - возрастная группа (программа обучения).
//   ФормаЗанятий     - ПеречислениеСсылка.ФормыЗанятий     - форма занятий.
//   УчебныйГод       - СправочникСсылка.УчебныеГода       - учебный год.
//   ДатаНаДату       - Дата - дата, на которую определяется цена.
//                      Если не указана, используется текущая дата сеанса.
//
// Возвращаемое значение:
//   Число, Неопределено - цена за занятие; Неопределено, если цена не установлена.
//
Функция ЦенаЗаЗанятие(ВозрастнаяГруппа, ФормаЗанятий, УчебныйГод, ДатаНаДату = Неопределено) Экспорт

	Если ДатаНаДату = Неопределено Тогда
		ДатаНаДату = ТекущаяДатаСеанса();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЦеныОбученияСрезПоследних.ЦенаЗаЗанятие КАК ЦенаЗаЗанятие
		|ИЗ
		|	РегистрСведений.ЦеныОбучения.СрезПоследних(
		|		&Дата,
		|		ВозрастнаяГруппа = &ВозрастнаяГруппа
		|			И ФормаЗанятий = &ФормаЗанятий
		|			И УчебныйГод = &УчебныйГод) КАК ЦеныОбученияСрезПоследних";

	Запрос.УстановитьПараметр("Дата", ДатаНаДату);
	Запрос.УстановитьПараметр("ВозрастнаяГруппа", ВозрастнаяГруппа);
	Запрос.УстановитьПараметр("ФормаЗанятий", ФормаЗанятий);
	Запрос.УстановитьПараметр("УчебныйГод", УчебныйГод);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЦенаЗаЗанятие;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
