#Область ПрограммныйИнтерфейс

// Возвращает стоимость одного занятия по данным регистра сведений "ЦеныОбучения".
//
// Параметры:
//   ВозрастнаяГруппа - СправочникСсылка.ОбучающиеПрограммы - возрастная группа (программа обучения).
//   ФормаЗанятий     - ПеречислениеСсылка.ФормыЗанятий     - форма занятий.
//   УчебныйГод       - СправочникСсылка.УчебныеГода       - учебный год.
//   ДатаНаДату       - Дата - дата, на которую определяется цена.
//                      Если не указана, используется текущая дата сеанса.
//
// Возвращаемое значение:
//   Число, Неопределено - цена за занятие; Неопределено, если цена не установлена.
//
Функция ЦенаЗаЗанятие(ВозрастнаяГруппа, ФормаЗанятий, УчебныйГод, ДатаНаДату = Неопределено) Экспорт

	Если ДатаНаДату = Неопределено Тогда
		ДатаНаДату = ТекущаяДатаСеанса();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЦеныОбученияСрезПоследних.ЦенаЗаЗанятие КАК ЦенаЗаЗанятие
		|ИЗ
		|	РегистрСведений.ЦеныОбучения.СрезПоследних(
		|		&Дата,
		|		ВозрастнаяГруппа = &ВозрастнаяГруппа
		|			И ФормаЗанятий = &ФормаЗанятий
		|			И УчебныйГод = &УчебныйГод) КАК ЦеныОбученияСрезПоследних";

	Запрос.УстановитьПараметр("Дата", ДатаНаДату);
	Запрос.УстановитьПараметр("ВозрастнаяГруппа", ВозрастнаяГруппа);
	Запрос.УстановитьПараметр("ФормаЗанятий", ФормаЗанятий);
	Запрос.УстановитьПараметр("УчебныйГод", УчебныйГод);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЦенаЗаЗанятие;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Записывает договор с новым статусом и синхронизирует связанные объекты.
//
// Параметры:
//   Ссылка      - ДокументСсылка.ДоговорОбучения - договор.
//   НовыйСтатус - ПеречислениеСсылка.СтатусыДоговора - устанавливаемый статус.
//
Процедура УстановитьСтатус(Ссылка, НовыйСтатус) Экспорт

	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Объект.СтатусДоговора = НовыйСтатус;
	Объект.Записать(РежимЗаписиДокумента.Запись);

	СинхронизироватьСвязанныеОбъекты(Ссылка);

КонецПроцедуры

// Переводит договор в статус "Приостановлен".
//
// Параметры:
//   Ссылка - ДокументСсылка.ДоговорОбучения - договор.
//
Процедура Приостановить(Ссылка) Экспорт

	УстановитьСтатус(Ссылка, Перечисления.СтатусыДоговора.Приостановлен);

КонецПроцедуры

// Возвращает договор в статус "Действующий" и закрывает открытый период приостановки.
//
// Параметры:
//   Ссылка - ДокументСсылка.ДоговорОбучения - договор.
//
Процедура Возобновить(Ссылка) Экспорт

	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПоследняяОткрытаяПриостановка = Неопределено;
	Для Каждого СтрокаПриостановки Из Объект.ПриостановленияЗанятий Цикл
		Если ЗначениеЗаполнено(СтрокаПриостановки.ДатаНачала)
				И Не ЗначениеЗаполнено(СтрокаПриостановки.ДатаОкончания) Тогда
			ПоследняяОткрытаяПриостановка = СтрокаПриостановки;
		КонецЕсли;
	КонецЦикла;

	Если ПоследняяОткрытаяПриостановка <> Неопределено Тогда
		ПоследняяОткрытаяПриостановка.ДатаОкончания = ТекущаяДатаСеанса();
	КонецЕсли;

	Объект.СтатусДоговора = Перечисления.СтатусыДоговора.Действующий;
	Объект.Записать(РежимЗаписиДокумента.Запись);

	СинхронизироватьСвязанныеОбъекты(Ссылка);

КонецПроцедуры

// Переводит договор в статус "Расторгнут".
//
// Параметры:
//   Ссылка - ДокументСсылка.ДоговорОбучения - договор.
//
Процедура Расторгнуть(Ссылка) Экспорт

	УстановитьСтатус(Ссылка, Перечисления.СтатусыДоговора.Расторгнут);

КонецПроцедуры

// Приводит статусы клиента, ученика и состав групп в соответствие статусу договора.
//
// Параметры:
//   Ссылка - ДокументСсылка.ДоговорОбучения - договор.
//
Процедура СинхронизироватьСвязанныеОбъекты(Ссылка) Экспорт

	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СинхронизироватьКлиента(Объект);
	СинхронизироватьУченика(Объект);

	Если Объект.СтатусДоговора = Перечисления.СтатусыДоговора.Расторгнут
			Или Объект.СтатусДоговора = Перечисления.СтатусыДоговора.Проект Тогда
		УдалитьУченикаИзГрупп(Объект);
	ИначеЕсли Объект.СтатусДоговора = Перечисления.СтатусыДоговора.Действующий Тогда
		ДобавитьУченикаВГруппы(Объект);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СинхронизироватьКлиента(Объект)

	ОбъектКлиента = Объект.Плательщик.ПолучитьОбъект();
	Если ОбъектКлиента = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаДоговора = ОбъектКлиента.Договоры.Найти(Объект.Ссылка, "Договор");
	Если Объект.СтатусДоговора = Перечисления.СтатусыДоговора.Проект Тогда
		Если СтрокаДоговора <> Неопределено Тогда
			ОбъектКлиента.Договоры.Удалить(ОбъектКлиента.Договоры.Индекс(СтрокаДоговора));
		КонецЕсли;
	Иначе
		Если СтрокаДоговора = Неопределено Тогда
			СтрокаДоговора = ОбъектКлиента.Договоры.Добавить();
			СтрокаДоговора.Договор = Объект.Ссылка;
			СтрокаДоговора.Ученик = Объект.Ученик;
		КонецЕсли;
		СтрокаДоговора.СтатусДоговора = Объект.СтатусДоговора;
	КонецЕсли;

	ОбъектКлиента.ИзменитьСтатус();
	ОбъектКлиента.Записать();

КонецПроцедуры

Процедура СинхронизироватьУченика(Объект)

	ОбъектУченика = Объект.Ученик.ПолучитьОбъект();
	Если ОбъектУченика = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Объект.СтатусДоговора = Перечисления.СтатусыДоговора.Действующий
			Или Объект.СтатусДоговора = Перечисления.СтатусыДоговора.Приостановлен Тогда
		ОбъектУченика.Договор = Объект.Ссылка;
	ИначеЕсли ОбъектУченика.Договор = Объект.Ссылка Тогда
		ОбъектУченика.Договор = Документы.ДоговорОбучения.ПустаяСсылка();
	КонецЕсли;

	ОбъектУченика.ПересчитатьСтатус();
	ОбъектУченика.Записать();

КонецПроцедуры

Процедура ДобавитьУченикаВГруппы(Объект)

	ОбработанныеГруппы = Новый Соответствие;

	Для Каждого СтрокаГрафика Из Объект.ГрафикОказанияУслуг Цикл

		Если Не ЗначениеЗаполнено(СтрокаГрафика.Группа)
				Или ОбработанныеГруппы.Получить(СтрокаГрафика.Группа) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбработанныеГруппы.Вставить(СтрокаГрафика.Группа, Истина);

		ОбъектГруппы = СтрокаГрафика.Группа.ПолучитьОбъект();
		Если ОбъектГруппы = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ОбъектГруппы.СоставГруппы.Найти(Объект.Ученик, "Ученик") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ОбъектГруппы.СоставГруппы.Добавить();
		НоваяСтрока.Ученик = Объект.Ученик;
		НоваяСтрока.ДатаНачалаЗанятий = Объект.ДатаНачала;
		ОбъектГруппы.Записать();

	КонецЦикла;

КонецПроцедуры

Процедура УдалитьУченикаИзГрупп(Объект)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СоставГруппы.Ссылка КАК Группа
		|ИЗ
		|	Справочник.Группы.СоставГруппы КАК СоставГруппы
		|ГДЕ
		|	СоставГруппы.Ученик = &Ученик";
	Запрос.УстановитьПараметр("Ученик", Объект.Ученик);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		ОбъектГруппы = Выборка.Группа.ПолучитьОбъект();
		Если ОбъектГруппы = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СтрокаСостава = ОбъектГруппы.СоставГруппы.Найти(Объект.Ученик, "Ученик");
		Если СтрокаСостава = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ОбъектГруппы.СоставГруппы.Удалить(ОбъектГруппы.СоставГруппы.Индекс(СтрокаСостава));
		ОбъектГруппы.Записать();

	КонецЦикла;

КонецПроцедуры

#КонецОбласти
