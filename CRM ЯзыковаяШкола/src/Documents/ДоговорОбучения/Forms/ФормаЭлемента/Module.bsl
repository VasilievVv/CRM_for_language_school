#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьЗаголовок();
	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Приостановить(Команда)

	ПриостановитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Возобновить(Команда)

	ВозобновитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Расторгнуть(Команда)

	ПоказатьВопрос(
		Новый ОписаниеОповещения("РасторгнутьЗавершение", ЭтотОбъект),
		"Расторгнуть договор? Ученик будет исключён из всех групп.",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РасторгнутьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	РасторгнутьНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПриостановитьНаСервере()

	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Документы.ДоговорОбучения.Приостановить(Объект.Ссылка);
	ОбновитьПослеСменыСтатуса();

КонецПроцедуры

&НаСервере
Процедура ВозобновитьНаСервере()

	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Документы.ДоговорОбучения.Возобновить(Объект.Ссылка);
	ОбновитьПослеСменыСтатуса();

КонецПроцедуры

&НаСервере
Процедура РасторгнутьНаСервере()

	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Документы.ДоговорОбучения.Расторгнуть(Объект.Ссылка);
	ОбновитьПослеСменыСтатуса();

КонецПроцедуры

&НаСервере
Процедура ОбновитьПослеСменыСтатуса()

	Объект.Прочитать();
	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовок()

	Если Объект.Ссылка.Пустая() Тогда
		Заголовок = "Новый договор обучения";
	Иначе
		Заголовок = "Договор обучения " + Объект.Номер + " от "
			+ Формат(Объект.Дата, "ДЛФ=D");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступностьКоманд()

	Элементы.КнопкаПриостановить.Доступность =
		(Объект.СтатусДоговора = Перечисления.СтатусыДоговора.Действующий);

	Элементы.КнопкаВозобновить.Доступность =
		(Объект.СтатусДоговора = Перечисления.СтатусыДоговора.Приостановлен);

	Элементы.КнопкаРасторгнуть.Доступность =
		(Объект.СтатусДоговора = Перечисления.СтатусыДоговора.Действующий
			Или Объект.СтатусДоговора = Перечисления.СтатусыДоговора.Приостановлен);

КонецПроцедуры

#КонецОбласти
