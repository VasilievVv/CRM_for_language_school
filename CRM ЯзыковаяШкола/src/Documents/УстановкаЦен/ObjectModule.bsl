#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если НЕ ЗначениеЗаполнено(УчебныйГод) Тогда
		ВывестиСообщение("Не заполнен учебный год.", "УчебныйГод");
		Отказ = Истина;
	КонецЕсли;

	Если Цены.Количество() = 0 Тогда
		ВывестиСообщение("Таблица цен не заполнена.", "Цены");
		Отказ = Истина;
	КонецЕсли;

	ПроверитьДублиСтрокЦен(Отказ);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.ЦеныОбучения.Записывать = Истина;
	Движения.ЦеныОбучения.Очистить();

	Для Каждого СтрокаЦен Из Цены Цикл
		Запись = Движения.ЦеныОбучения.Добавить();
		
		Запись.Период 				= Дата;
		Запись.ВозрастнаяГруппа 	= СтрокаЦен.ВозрастнаяГруппа;
		Запись.ФормаЗанятий 		= СтрокаЦен.ФормаЗанятий;
		Запись.УчебныйГод 			= УчебныйГод;
		Запись.ЦенаЗаЗанятие 			= СтрокаЦен.ЦенаЗаЗанятие;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьДублиСтрокЦен(Отказ)

	ВстреченныеСочетания = Новый Соответствие;

	Для Каждого СтрокаЦен Из Цены Цикл
		Ключ = Новый Структура;
		Ключ.Вставить("ВозрастнаяГруппа", СтрокаЦен.ВозрастнаяГруппа);
		Ключ.Вставить("ФормаЗанятий", СтрокаЦен.ФормаЗанятий);

		Если ВстреченныеСочетания.Получить(Ключ) = Неопределено Тогда
			ВстреченныеСочетания.Вставить(Ключ, Истина);
			Продолжить;
		КонецЕсли;

		ВывестиСообщение(
			"Строка " + СтрокаЦен.НомерСтроки + ": сочетание возрастной группы и формы занятий уже указано выше.",
			"Цены");
		Отказ = Истина;
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиСообщение(Текст, Поле)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#КонецЕсли
