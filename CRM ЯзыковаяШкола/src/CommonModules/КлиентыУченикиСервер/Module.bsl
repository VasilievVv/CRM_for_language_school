#Область ПрограммныйИнтерфейс

// Заполняет фамилию, имя, отчество и сокращённое ФИО по полному ФИО из реквизита Наименование.
// Если ФИО записано неверно (цифры, смешение алфавитов), реквизиты не изменяются.
//
// Параметры:
//  Объект - СправочникОбъект.Клиенты, СправочникОбъект.Ученики - заполняемый объект.
//
// Возвращаемое значение:
//  Булево - Истина, если ФИО написано верно и части ФИО заполнены.
//
Функция ЗаполнитьЧастиФИО(Объект) Экспорт
	
	ФИО = СокрЛП(Объект.Наименование);
	
	Если ПустаяСтрока(ФИО) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ФизическиеЛицаКлиентСервер.ФИОНаписаноВерно(ФИО) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ФИО = ТРег(ФИО);
	Объект.Наименование = ФИО;
	
	ЧастиИмени = ФизическиеЛицаКлиентСервер.ЧастиИмени(ФИО);
	
	Объект.Фамилия = ЧастиИмени.Фамилия;
	Объект.Имя = ЧастиИмени.Имя;
	Объект.Отчество = ЧастиИмени.Отчество;
	Объект.СокращенноеФИО = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ФИО);
	
	Возврат Истина;
	
КонецФункции

// Возвращает количество полных лет на указанную дату.
//
// Параметры:
//  ДатаРождения - Дата - дата рождения.
//  ДатаОтсчёта  - Дата - дата, на которую рассчитывается возраст. По умолчанию - текущая дата сеанса.
//
// Возвращаемое значение:
//  Число - количество полных лет; 0, если дата рождения не заполнена.
//
Функция ВозрастНаДату(ДатаРождения, ДатаОтсчёта = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ДатаРождения) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ДатаОтсчёта = Неопределено Тогда
		ДатаОтсчёта = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Возраст = Год(ДатаОтсчёта) - Год(ДатаРождения);
	
	Если Месяц(ДатаОтсчёта) < Месяц(ДатаРождения)
		Или (Месяц(ДатаОтсчёта) = Месяц(ДатаРождения) И День(ДатаОтсчёта) < День(ДатаРождения)) Тогда
		Возраст = Возраст - 1;
	КонецЕсли;
	
	Возврат Макс(Возраст, 0);
	
КонецФункции

// Возвращает возраст со словом "год" в правильной форме: "1 год", "2 года", "5 лет".
//
// Параметры:
//  Возраст - Число - количество полных лет.
//
// Возвращаемое значение:
//  Строка - текстовое представление возраста; пустая строка, если возраст не заполнен.
//
Функция ПредставлениеВозраста(Возраст) Экспорт
	
	Если Возраст <= 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Шаблон = НСтр("ru = ';%1 год;;%1 года;%1 лет;%1 года'");
	Возврат СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(Шаблон, Возраст);
	
КонецФункции

// Возвращает текст сообщения о неверно записанном ФИО.
//
// Возвращаемое значение:
//  Строка - текст сообщения пользователю.
//
Функция ТекстОшибкиФИО() Экспорт
	
	Возврат НСтр("ru = 'ФИО должно быть записано только кириллицей или только латиницей.
		|Цифры, знаки и смешение алфавитов недопустимы.'");
	
КонецФункции

#КонецОбласти
