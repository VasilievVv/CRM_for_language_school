#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Пересчитывает статус ученика по статусам его договоров обучения.
//
Процедура ПересчитатьСтатус() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Договоры.СтатусДоговора КАК СтатусДоговора
		|ИЗ
		|	Документ.ДоговорОбучения КАК Договоры
		|ГДЕ
		|	Договоры.Ученик = &Ученик";
	Запрос.УстановитьПараметр("Ученик", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();

	ЕстьДействующий = Ложь;
	ЕстьПриостановленный = Ложь;
	ЕстьРасторгнутый = Ложь;

	Пока Выборка.Следующий() Цикл
		Если Выборка.СтатусДоговора = Перечисления.СтатусыДоговора.Действующий Тогда
			ЕстьДействующий = Истина;
		ИначеЕсли Выборка.СтатусДоговора = Перечисления.СтатусыДоговора.Приостановлен Тогда
			ЕстьПриостановленный = Истина;
		ИначеЕсли Выборка.СтатусДоговора = Перечисления.СтатусыДоговора.Расторгнут Тогда
			ЕстьРасторгнутый = Истина;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьДействующий Тогда
		Статус = Перечисления.СтатусыУченика.Активный;
	ИначеЕсли ЕстьПриостановленный Тогда
		Статус = Перечисления.СтатусыУченика.ВременноПриостановил;
	ИначеЕсли ЕстьРасторгнутый Тогда
		Статус = Перечисления.СтатусыУченика.ПрекратилОбучение;
	Иначе
		Статус = Перечисления.СтатусыУченика.Потенциальный;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(Основание, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(Основание) = Тип("СправочникСсылка.Клиенты") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		РеквизитыКлиента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Основание, "Наименование");
		
		Владелец = Основание;
		Наименование = РеквизитыКлиента.Наименование;
		
		КлиентыУченикиСервер.ЗаполнитьЧастиФИО(ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ПустаяСтрока(Наименование) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ФизическиеЛицаКлиентСервер.ФИОНаписаноВерно(Наименование) Тогда
		
		Отказ = Истина;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = КлиентыУченикиСервер.ТекстОшибкиФИО();
		Сообщение.Поле = "Наименование";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	КлиентыУченикиСервер.ЗаполнитьЧастиФИО(ЭтотОбъект);
	Возраст = КлиентыУченикиСервер.ВозрастНаДату(ДатаРождения);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
