#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Удаляет строку договора из табличной части "Договоры".
//
// Параметры:
//   Договор - ДокументСсылка.ДоговорОбучения - удаляемый договор.
//
Процедура УдалитьДоговор(Договор) Экспорт

	СтрокаДоговора = Договоры.Найти(Договор, "Договор");
	Если СтрокаДоговора = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Договоры.Удалить(Договоры.Индекс(СтрокаДоговора));

КонецПроцедуры

// Пересчитывает статус клиента по статусам его договоров.
//
Процедура ИзменитьСтатус() Экспорт

	ЕстьДействующийДоговор = Ложь;
	ЕстьПриостановленныйДоговор = Ложь;

	Для Каждого СтрокаДоговора Из Договоры Цикл
		Если СтрокаДоговора.СтатусДоговора = Перечисления.СтатусыДоговора.Действующий Тогда
			ЕстьДействующийДоговор = Истина;
		ИначеЕсли СтрокаДоговора.СтатусДоговора = Перечисления.СтатусыДоговора.Приостановлен Тогда
			ЕстьПриостановленныйДоговор = Истина;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьДействующийДоговор Или ЕстьПриостановленныйДоговор Тогда
		Статус = Перечисления.СтатусыКлиента.Активный;
	ИначеЕсли Договоры.Количество() = 0 Тогда
		Статус = Перечисления.СтатусыКлиента.Потенциальный;
	Иначе
		Статус = Перечисления.СтатусыКлиента.Бывший;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ПустаяСтрока(Наименование) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ФизическиеЛицаКлиентСервер.ФИОНаписаноВерно(Наименование) Тогда
		
		Отказ = Истина;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = КлиентыУченикиСервер.ТекстОшибкиФИО();
		Сообщение.Поле = "Наименование";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	КлиентыУченикиСервер.ЗаполнитьЧастиФИО(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
